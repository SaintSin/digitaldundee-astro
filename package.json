{
  "name": "astroinitial",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node --import tsx scripts/generate-rss-images.ts",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "prettier": "exec prettier . --write",
    "clean": "rm -rf dist .astro public/rss-images",
    "type-check": "astro check",
    "test": "astro check && biome check .",
    "rss-images": "node --import tsx scripts/generate-rss-images.ts",
    "check-links": "linkinator https://digitaldundee.netlify.app --recurse --skip 'linkedin.com|twitter.com|facebook.com|youtube.com'",
    "check-links-companies": "node --import tsx scripts/check-company-links.ts",
    "fmt": "oxfmt",
    "purge": "rm -rf dist .astro .netlify node_modules"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/netlify": "^8.2.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@felixicaza/astro-capo": "^1.2.2",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "astro": "^7.3.8",
    "astro-animations": "^0.0.6",
    "astro-embed": "^0.14.0",
    "astro-icon": "^1.2.0",
    "astro-llms-md": "^3.0.2",
    "astro-robots-txt": "^1.0.0",
    "node-html-parser": "^9.0.4",
    "open-props": "^1.7.23",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.15",
    "jsdom": "^30.1.2",
    "linkinator": "^8.1.0",
    "oxfmt": "^0.72.0",
    "postcss-jit-props": "^1.0.16",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-css-order": "^2.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
