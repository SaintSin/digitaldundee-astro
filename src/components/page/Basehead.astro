---
// @components/page/Basehead.astro
import JsonLd from '@components/page/JsonLd.astro';
import { siteMetadata } from '@config/siteMetadata';
import { Head } from '@felixicaza/astro-capo';
import type { MetaData } from '@types';

interface Props {
  metaData: MetaData;
}

const { metaData } = Astro.props;
const {
  title,
  description,
  imageOG = 'generic-social-1200x630.png',
  altOG = 'Social Media Card',
  schema,
} = metaData;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// imageOG is either a processed image path (/_astro/...), a full URL, or the
// filename of a card in public/images/social/
const ogImage = /^(\/|https?:)/.test(imageOG)
  ? new URL(imageOG, Astro.site).href
  : new URL(`images/social/${imageOG}`, Astro.site).href;

import '@styles/style.css';
---

<Head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={altOG} />
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta
    property="twitter:image"
    content={ogImage}
  />
  <meta name="twitter:image:alt" content={altOG} />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="generator" content={Astro.generator} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <!-- Preload variable fonts -->
  <link
    rel="preload"
    href="/fonts/OpenSans-VariableFont_wdthwght.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    rel="preload"
    href="/fonts/Montserrat-VariableFont_wght.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <link rel="expect" href="#content" blocking="render" />

  <!-- JSON-LD Structured Data -->
  <JsonLd schema={schema} />

  <!-- Google Analytics: gtag.js is only loaded after the visitor accepts (see ConsentBanner) -->
  <script is:inline define:vars={{ measurementId: siteMetadata.measurementId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    // Analytics denied until the visitor accepts
    gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });
    gtag('js', new Date());
    gtag('config', measurementId, { send_page_view: false });

    window.grantConsent = function () {
      if (window.__gtagLoaded) {
        gtag('consent', 'update', { analytics_storage: 'granted' });
        return;
      }
      window.__gtagLoaded = true;
      gtag('consent', 'update', { analytics_storage: 'granted' });
      var s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
      s.defer = true;
      // page_view only after gtag.js has processed the consent update,
      // otherwise it is evaluated while storage is still denied and dropped
      s.onload = function () {
        gtag('event', 'page_view', {
          page_location: window.location.href,
          page_title: document.title,
        });
      };
      document.head.appendChild(s);
    };

    window.revokeConsent = function () {
      gtag('consent', 'update', { analytics_storage: 'denied' });
    };
  </script>
</Head>
