---
// src/components/page/Footer.astro
import NewsArchive from '@components/NewsArchive.astro';
import { siteMetadata } from '@config/siteMetadata';
import FormFooter from './FormFooter.astro';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getUTCFullYear();
---

<footer class="footer">
  <div class="wrapper columns">
    <FormFooter />
    <section class="flow">
      <NewsArchive limit={8} />
      <h2 class="connect">Connect With Us</h2>
      <SocialLinks />
    </section>
  </div>
  <div class="wrapper copyright">
    <p>&copy; &nbsp;{year} {siteMetadata.name} - All Rights Reserved</p>
    <p>
      <a href="/privacy-policy/">Privacy policy</a>
      <button type="button" data-consent-settings>Cookie settings</button>
    </p>
  </div>
</footer>
<style>
  .footer {
    --flow-heading-space: var(--space-xs); /* headings sit close to their content */
    margin-block-start: 0;
    background: var(--color-dark);
    color: var(--gray-1);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-m);
    padding-block: var(--space-2xl);
  }

  /* One heading style for every footer block (the blocks live in child components) */
  .footer :global(h2) {
    color: var(--gray-1);
    font-weight: 600;
    font-size: var(--step-1);
  }

  /* Gap between the news archive block and "Connect With Us" */
  .connect {
    --flow-space: var(--size-fluid-4);
  }

  .copyright {
    display: flex;
    background: var(--color-darker);
    padding-block: var(--space-s);
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
  }

  .copyright a,
  .copyright button {
    margin-inline-start: var(--space-s);
    cursor: pointer;
    border: 0;
    background: none;
    padding: 0;
    color: var(--gray-3);
    font: inherit;
    font-size: var(--step--1);
    text-decoration: underline;
  }

  .copyright a:first-child {
    margin-inline-start: 0;
  }

  .copyright p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--gray-4);
    text-align: center;
  }
</style>
