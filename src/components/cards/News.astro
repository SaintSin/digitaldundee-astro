---
// src/components/cards/News.astro
import { cardImage } from '@utils/imageFit';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@styles/blocks/card.css';

interface Props {
  title: string;
  excerpt: string;
  pubDate: Date;
  imageSrc: ImageMetadata;
  imageAlt: string;
  href: string;
  priority?: boolean; // eager-load images that are above the fold
}

const {
  title,
  excerpt,
  pubDate,
  imageSrc,
  imageAlt,
  href,
  priority = false,
} = Astro.props;
---

<article class="card news" {...cardImage(imageSrc)}>
  <a href={href}>
    <Picture src={imageSrc} alt={imageAlt} quality={30} priority={priority} decoding="async" formats={['avif', 'webp']} />
    <h3>{title}</h3>
    <time datetime={pubDate.toISOString()}>
      {pubDate.toLocaleDateString('en-GB')}
    </time>
    {excerpt && <p>{excerpt}</p>}
  </a>
</article>
