---
import { getCollection } from 'astro:content';
import { getArchiveEntries } from '@utils/newsArchive';

interface Props {
  limit?: number;
  showHeading?: boolean;
  heading?: string;
}

const { limit = 8, showHeading = true, heading = 'News Archive' } = Astro.props;

const news = await getCollection('news');
const archiveEntries = getArchiveEntries(news);
const displayEntries = archiveEntries.slice(0, limit);
---

{showHeading && <h2>{heading}</h2>}

<div class="archive-list">
  {
    displayEntries.map((entry) => (
      <span class="archive-item pill">
        <a href={`/news-archive/${entry.yearMonth}`}>{entry.label}</a>
        <span class="count">({entry.count})</span>
      </span>
    ))
  }
</div>

{
  archiveEntries.length > limit && (
    <a class="btn pill" href="/news-archive">
      View More News Archives
    </a>
  )
}

<style>
  .archive-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .archive-list + .btn {
    --flow-space: var(--space-xs);
  }

  .archive-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    transition:
      background 0.2s ease,
      color 0.2s ease;
    outline: 1px solid var(--gray-6);
    background: transparent;
    padding-block: var(--space-3xs);
    color: var(--gray-2);

    &:hover {
      background: var(--gray-7);
      outline-color: var(--gray-4);
      color: var(--gray-1);
    }
  }

  .archive-item a {
    color: inherit;
    text-decoration: none;
  }

  .count {
    color: var(--gray-5);
    font-size: var(--step--2);
  }
</style>
