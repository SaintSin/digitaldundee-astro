---
// src/layouts/BaseLayout.astro

import Basehead from '@components/page/Basehead.astro';
import ConsentBanner from '@components/page/ConsentBanner.astro';
import Footer from '@components/page/Footer.astro';
import Header from '@components/page/Header.astro';
import type { MetaData } from '@types';
import { AstroAnimations } from 'astro-animations';

interface Props {
  metaData: MetaData;
}

const { metaData } = Astro.props;
---

<!doctype html>
<html lang="en">
  <Basehead metaData={metaData} />
  <body>
    <Header />
    <AstroAnimations />

    <main class="content" id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
<style>
  :root {
    --wrapper-padding-inline: var(--space-xs);
    --wrapper-max-width: 1170px;
    --section-padding-block: var(--size-fluid-4);
    --paragraph-max-width: 55ch;
  }
  /* Space between page content and the footer, on every page */
  .content {
    padding-block-end: var(--size-fluid-4);
  }
  body {
    font-family: var(--font-opensans);
  }
  p {
  }
</style>
