---
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Hero from '@components/Hero.astro';
import header from '@images/header/services.jpg';
import Layout from '@layouts/BaseLayout.astro';
import { digitalDundeeOrganization } from '@utils/schema';

const meta = {
  title: 'Get Services | Digital Dundee',
  description: 'Get in touch for free help to find and commission services.',
  imageOG: 'generic-social-1200x630.png',
  altOG: 'Get Services',
  schema: digitalDundeeOrganization,
};
---

<Layout metaData={meta}>
  <Hero title="Get Services" image={header} alt="Get Services page header" />
  <div class="wrapper flow">
    <Breadcrumbs />
    <h2>Get Services</h2>
    <p>Coming soon.</p>
    <p>Get in touch for free help to find and commission services.</p>
  </div>
</Layout>
